{
  "name": "tinta",
  "version": "1.0.0",
  "description": "Notas, escritura a mano, audio y PDF sincronizados con una carpeta de Google Drive (PWA para Android y escritorio).",
  "scripts": {
    "dev": "node scripts/copy-pdf-assets.mjs && vite",
    "build": "node scripts/copy-pdf-assets.mjs && vite build",
    "preview": "vite preview",
